[Unit]
Description=p37 version control daemon
Documentation=https://github.com/chenyiwen/p37
After=local-fs.target
# L2 的 /srv/repo 必须已经挂载；P36 的 L2 是实例主盘，通常 local-fs 之后已就绪。
ConditionPathIsDirectory=/srv/repo

[Service]
Type=simple
User=p36
Group=p36
# p36 需要读 /dev/disk/by-label/P37PAYLOAD 对应的 virtio-blk。
# 若 L0 里没有 disk 组，改成 udev 规则把该设备 GROUP 设为 p36。
SupplementaryGroups=disk

Environment=P37_REPO=/srv/repo
Environment=P37_PAYLOAD_LABEL=P37PAYLOAD
Environment=P37_PAYLOAD_MOUNT=/run/p37-payload
Environment=P37_CONFIG=/usr/local/share/p37/config.toml
Environment=TMPDIR=/srv/repo/.p37/tmp

# systemd 创建 /run/p37-payload（属主 p36），p37-run 在里面只读挂载投递盘。
RuntimeDirectory=p37-payload
RuntimeDirectoryMode=0755

ExecStart=/usr/local/bin/p37-run
Restart=on-failure
RestartSec=2s
TimeoutStopSec=60s
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal

# 只保留挂载 overlay/投递盘所需的能力，不要求 root。
AmbientCapabilities=CAP_SYS_ADMIN
CapabilityBoundingSet=CAP_SYS_ADMIN
NoNewPrivileges=yes

# 所有可写状态只允许落在 /srv/repo；/run 只用于投递盘挂载点。
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/srv/repo /run/p37-payload
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
