#!/bin/sh
# p37-mcp —— MCP 客户端的 stdio 入口（多 repo 兼容）。
set -eu

ROOT=${P37_ROOT:-/srv/repos}
if [ -x /usr/local/lib/p37/p37d ]; then
    MNT=/usr/local/lib/p37
else
    MNT=${P37_PAYLOAD_MOUNT:-/run/p37-payload}
fi
TMPDIR=${TMPDIR:-$ROOT/.p37/tmp}
export TMPDIR
mkdir -p "$TMPDIR" 2>/dev/null || true

i=0
while [ ! -x "$MNT/p37d" ] && [ "$i" -lt 50 ]; do
    i=$((i + 1))
    sleep 0.2
done
if [ ! -x "$MNT/p37d" ]; then
    echo "p37-mcp: $MNT/p37d 不存在；p37d.service 是否已启动？" >&2
    exit 1
fi
if [ -d "$ROOT/.p37" ]; then
    exec "$MNT/p37d" --stdio --root "$ROOT"
fi
exec "$MNT/p37d" --stdio --repo "${P37_REPO:-/srv/repo}"
