#!/bin/sh
# p37-run —— P36 实例内的稳定引导脚本（单 daemon 多 repo）。
#
# 契约：
#   1. 按 ext4 label 等宿主投递的只读小盘；
#   2. 挂载到 P37_PAYLOAD_MOUNT（默认 /usr/local/lib/p37，兼容 /run/p37-payload）；
#   3. 校验 p37/p37d/manifest；
#   4. 创建 /srv/repos 与控制面，迁移旧 /srv/repo 注册；
#   5. exec p37d --root。
set -eu

ROOT=${P37_ROOT:-/srv/repos}
LEGACY=${P37_REPO:-/srv/repo}
MNT=${P37_PAYLOAD_MOUNT:-/usr/local/lib/p37}
LABEL=${P37_PAYLOAD_LABEL:-P37PAYLOAD}
CONFIG=${P37_CONFIG:-/usr/local/share/p37/config.toml}
MOUNTER=${P37_MOUNTER:-/usr/local/bin/p37-mount}

# 兼容旧镜像：/usr/local/lib/p37 没有二进制时，尝试挂载 payload 到
# /run/p37-payload，并使用那里的二进制。
if [ ! -x "$MNT/p37d" ] && [ -x /run/p37-payload/p37d ]; then
    MNT=/run/p37-payload
fi
if [ ! -x "$MNT/p37d" ]; then
    mkdir -p "$MNT"
    "$MOUNTER" --label "$LABEL" --target "$MNT" --timeout 20s
fi

for f in p37 p37d manifest.json; do
    if [ ! -e "$MNT/$f" ]; then
        echo "p37-run: 投递盘缺少 $f（label=$LABEL）" >&2
        exit 1
    fi
done
if [ ! -x "$MNT/p37" ] || [ ! -x "$MNT/p37d" ]; then
    echo "p37-run: p37/p37d 不可执行" >&2
    exit 1
fi

want=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$MNT/manifest.json" | head -n 1)
if [ -z "$want" ]; then
    echo "p37-run: manifest.json 缺少 version" >&2
    exit 1
fi
got=$("$MNT/p37d" --version)
case "$got" in
    *"version=$want "*) ;;
    *)
        echo "p37-run: 版本不一致：manifest=$want，p37d=$got" >&2
        exit 1
        ;;
esac

mkdir -p "$ROOT/.p37/tmp" "$ROOT/.p37/trash"
chmod 0750 "$ROOT" 2>/dev/null || true
chmod 0700 "$ROOT/.p37" 2>/dev/null || true
export TMPDIR="$ROOT/.p37/tmp"

# 旧单仓库：不移动目录，由 p37d 在 registry 中原地注册为 default。
# 这里只做一次格式迁移（幂等）；失败会让 systemd 记录清晰原因。
if [ -d "$LEGACY/.p37" ]; then
    "$MNT/p37" migrate "$LEGACY" >&2 || true
fi

if [ -r "$CONFIG" ]; then
    # 根配置：多 repo 的 daemon/workspace 默认值。
    if [ ! -e "$ROOT/.p37/config.toml" ]; then
        cp "$CONFIG" "$ROOT/.p37/config.toml"
    fi
fi

"$MNT/p37d" --check --root "$ROOT" >&2
exec "$MNT/p37d" --root "$ROOT"
